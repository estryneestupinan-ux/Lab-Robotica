<?xml version="1.0"?>
<package format="3">

  <name>rviz</name>
  <version>1.0.0</version>

  <description>
    URDF description package for Kinova robot.
    Contains the robot model, meshes and ROS 2 launch files.
  </description>
  <maintainer email="est.joan.gomez@unimilitar.edu.co">Joan</maintainer>
  <license>BSD</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher_gui</exec_depend>
  <exec_depend>rviz2</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>

</package>
