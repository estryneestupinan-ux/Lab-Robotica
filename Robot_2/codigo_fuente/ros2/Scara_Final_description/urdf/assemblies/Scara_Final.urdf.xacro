<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="Scara_Final_macro">

  <!-- DEFINICIÓN DE LA MACRO -->
  <xacro:macro name="Scara_Final" params="prefix">

    <!-- Links -->
    <link name="${prefix}base_link">
      <inertial>
        <origin xyz="0.132907 0.020051 0.000111" rpy="0 0 0"/>
        <mass value="1.611636"/>
        <inertia ixx="1.842877e-03" ixy="-1.008885e-03" ixz="-6.378591e-07"
                 iyy="6.440245e-03" iyz="-1.377925e-06" izz="6.343043e-03"/>
      </inertial>
      <visual>
        <origin xyz="0.000000 0.000000 0.000000" rpy="3.141593 0.000000 0.000000"/>
        <geometry>
          <mesh filename="package://Scara_Final_description/meshes/Scara_Final/base_link.dae" scale="1 1 1"/>
        </geometry>
        <material name="Acero"/>
      </visual>
      <collision>
        <origin xyz="0.000000 0.000000 0.000000" rpy="3.141593 0.000000 0.000000"/>
        <geometry>
          <mesh filename="package://Scara_Final_description/meshes/Scara_Final/base_link.dae" scale="1 1 1"/>
        </geometry>
      </collision>
    </link>

    <link name="${prefix}Cremallera2">
      <inertial>
        <origin xyz="-0.252371 -0.157170 -0.024697" rpy="0 0 0"/>
        <mass value="0.375726"/>
        <inertia ixx="3.455143e-05" ixy="1.171535e-06" ixz="1.098812e-06"
                 iyy="4.475029e-04" iyz="2.998619e-08" izz="4.328522e-04"/>
      </inertial>
      <visual>
        <origin xyz="-0.308358 -0.165300 -0.009650" rpy="0.000000 0.000000 0.000000"/>
        <geometry>
          <mesh filename="package://Scara_Final_description/meshes/Scara_Final/Cremallera2.dae" scale="1 1 1"/>
        </geometry>
        <material name="Acero"/>
      </visual>
      <collision>
        <origin xyz="-0.308358 -0.165300 -0.009650" rpy="0.000000 0.000000 0.000000"/>
        <geometry>
          <mesh filename="package://Scara_Final_description/meshes/Scara_Final/Cremallera2.dae" scale="1 1 1"/>
        </geometry>
      </collision>
    </link>

    <!-- Joints -->
    <joint name="${prefix}Corredera_4" type="prismatic">
      <parent link="${prefix}base_link"/>
      <child link="${prefix}Cremallera2"/>
      <origin xyz="0.030900 0.291858 0.024300" rpy="0.000000 0.000000 1.570796"/>
      <axis xyz="1.000000 0.000000 0.000000"/>
      <limit lower="0.015000" upper="0.040000" effort="100.0" velocity="1.00"/>
    </joint>

    <!-- ROS 2 control -->
    <ros2_control name="${prefix}Scara_Final_system" type="system">
  <hardware>
    <plugin>gz_ros2_control/GazeboSimSystem</plugin>
  </hardware>

  <joint name="${prefix}Revoluci_n_1">
    <command_interface name="position"/>
    <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
    <state_interface name="velocity"/>
  </joint>

  <joint name="${prefix}Revoluci_n_2">
    <command_interface name="position"/>
    <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
    <state_interface name="velocity"/>
  </joint>

  <joint name="${prefix}Corredera_4">
    <command_interface name="position"/>
    <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
    <state_interface name="velocity"/>
  </joint>
</ros2_control>

  </xacro:macro>

  <!-- LLAMADA A LA MACRO (INDISPENSABLE) -->
  <xacro:Scara_Final prefix=""/>

  <gazebo>
    <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(find Scara_Final_description)/config/controllers.yaml</parameters>
    </plugin>
  </gazebo>

</robot>