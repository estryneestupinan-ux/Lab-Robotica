      <collision>
        <origin xyz="-0.089343 -0.080111 -0.080300" rpy="1.570796 0.000000 0.730973"/>
        <geometry>
          <mesh filename="package://Robrot_description/meshes/Brazo1_Unido/Brazo1_Unido_collision.stl" scale="0.01 0.01 0.01"/>
        </geometry>
