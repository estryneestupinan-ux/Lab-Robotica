      </collision>
    </link>

    <link name="Cremallera2">
      <inertial>
        <origin xyz="0.332650 -0.147155 -0.070159" rpy="0 0 0"/>
        <mass value="0.376862"/>
        <inertia ixx="3.488333e-05" ixy="8.573198e-07" ixz="2.093134e-06"
                 iyy="4.512250e-04" iyz="1.211059e-07" izz="4.363203e-04"/>
      </inertial>
      <visual>
        <origin xyz="0.276497 -0.155300 -0.055064" rpy="0.000000 0.000000 0.000000"/>
        <geometry>
          <mesh filename="package://Robrot_description/meshes/Robrot/Cremallera2.dae" scale="1 1 1"/>
        </geometry>
        <material name="Acero"/>
      </visual>
      <collision>
        <origin xyz="0.276497 -0.155300 -0.055064" rpy="0.000000 0.000000 0.000000"/>
        <geometry>
          <mesh filename="package://Robrot_description/meshes/Robrot/Cremallera2_collision.stl" scale="0.01 0.01 0.01"/>
        </geometry>
      </collision>
