<?xml version="1.0"?>
<robot name="Robrot">

  <!-- sim:=true  -> Gazebo (gz_ros2_control)   |   sim:=false -> RViz con hardware simulado (mock) -->
  
  

  <!-- Materials (shared across all assemblies) -->
  <material name="Acero">
    <color rgba="0.627 0.627 0.627 1.0"/>
  </material>

  <!-- Assembly includes -->

  <!-- Instantiate assemblies -->
  

    <!-- Links -->
    <link name="base_link">
      <inertial>
        <origin xyz="0.052678 0.037753 -0.000515" rpy="0 0 0"/>
        <mass value="3.116656"/>
        <inertia ixx="7.260591e-03" ixy="-2.850225e-04" ixz="-3.842745e-06"
                 iyy="1.452437e-02" iyz="-4.241836e-05" izz="1.401797e-02"/>
      </inertial>
      <visual>
        <origin xyz="0.000000 0.000000 0.000000" rpy="3.141593 0.000000 3.141593"/>
        <geometry>
          <mesh filename="package://Robrot_description/meshes/base_link/base_link.dae" scale="1 1 1"/>
        </geometry>
        <material name="Acero"/>
      </visual>
      <collision>
        <origin xyz="0.000000 0.000000 0.000000" rpy="3.141593 0.000000 3.141593"/>
        <geometry>
          <mesh filename="package://Robrot_description/meshes/base_link/base_link_collision.stl" scale="0.01 0.01 0.01"/>
        </geometry>
      </collision>
    </link>

  
  

    <!-- Links -->
    <link name="Brazo1_Unido">
